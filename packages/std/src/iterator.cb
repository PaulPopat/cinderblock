namespace std {
  struct iterator
    data: unknown
    next: unknown
    done: bool
  ;

  let iterator_next (_s: iterator) =
    _s.done ? { data = null, next = null, done = true } : _s.next
  ;

  let iterator_fromArray (_s: unknown[]) =
      let internal (index: int) =
          let data =  _s @ index;
          let done = null == data;
        {
          data = data,
          next = !done ? { index = index + 1 } -> internal : null,
          done = done,
        }
      ;
    { index = 0 } -> internal
  ;

  let [test="std_iterator creates an iterator from an array"] =
    {
      actual = [1, 2, 3]
        --> iterator_fromArray
        --> 
          {
            initial = 0,
            reducer = let (_s: int, current: int) = _s + current;,
          }
          -> iterator_reduce,
      expected = 6,
    }
  ;

  let iterator_reduce (
    _s: iterator,
    initial: unknown,
    reducer: (_s: T, current: unknown): unknown
  ) =
    let internal (current: unknown, entry: iterator) =
      entry.done
        ? {
            current = current,
            entry = entry,
          }
        : {
            current = { _s = entry.data, current = current } -> reducer,
            entry = entry --> iterator_next
          } -> internal
    ;

    (
      { current = initial, entry = _s } -> internal
    ).current
  ;

  let iterator_select (_s: iterator, selector: (_s: unknown): unknown): iterator =
    {
      data = !_s.done ? _s.data --> selector : null,
      next = !_s.done
        ? { _s = _s --> iterator_next, selector = selector } -> iterator_select
        : null,
      done = _s.done,
    }
  ;

  let [test="std_iterator selects over an iterator"] =
    {
      actual = [1, 2, 3]
        --> iterator_fromArray
        -->
          {
            selector = let (_s: int) = _s + 1;,
          }
          -> iterator_select
        --> iterator_toArray,
      expected = [2, 3, 4],
    }
  ;

  let iterator_where (_s: iterator, predicate: (_s: unknown): bool) =
    _s.done
      ? _s
      : _s.data --> predicate
      ? _s
      : (_s.next as iterator) --> { predicate = predicate } -> iterator_where
  ;

  let iterator_concat (_s: iterator, addition: unknown) =
    _s.done
      ? {
          data = addition,
          done = false,
          next = {
            done = true,
            data = null,
            next = null,
          },
        }
      : {
          ..._s,
          next = { _s = _s --> iterator_next, addition = addition } -> iterator_concat,
        }
  ;

  let [test="std_iterator adds an entry"] =
    {
      actual = [1, 2, 3]
        --> iterator_fromArray
        --> { addition = 4 } -> iterator_concat
        --> iterator_toArray,
      expected = [1, 2, 3, 4],
    }
  ;

  let iterator_flatten (_s: iterator) =
    {
      _s = _s,
      initial =
        {
          data = null,
          next = null,
          done = true,
        },
      reducer =
        let (_s: iterator, current: iterator) =
          {
            _s = current,
            addition = _s,
          } -> iterator_concat
        ;,
    } -> iterator_reduce
  ;

  let iterator_length (_s: iterator): int =
    {
      _s = _s,
      initial = 0,
      reducer = let (current: int, _s: unknown) = current + 1;
    } -> iterator_reduce
  ;

  let [test="std_iterator gets the length"] =
    {
      actual = [1, 2, 3]
        --> iterator_fromArray
        --> iterator_length,
      expected = 3,
    }
  ;

  let iterator_toArray (_s: iterator) =
    {
      _s = _s,
      initial = [],
      reducer = let (_s: unknown, current: unknown[]) = current ++ _s;,
    } -> iterator_reduce
  ;

  let iterator_some (_s: iterator,predicate: (_s: unknown): bool) =
    _s.done
      ? false
      : (_s.data --> predicate) ||
        ({ _s = _s --> iterator_next, predicate = predicate } -> iterator_some)
  ;

  let [test="std_iterator matches against some"] =
    {
      actual = [1, 2, 3]
        --> iterator_fromArray
        --> ({ predicate = let (_s: int) = _s == 2; } -> iterator_some),
      expected = true,
    }
  ;

  let [test="std_iterator matches missing against some"] =
    {
      actual = [1, 2, 3]
        --> iterator_fromArray
        --> ({ predicate = let (_s: int) = _s == 4; } -> iterator_some),
      expected = false,
    }
  ;

  let iterator_find (_s: iterator, predicate: (_s: unknown): bool) =
    let internal (_s: iterator): T =
       _s.done
        ? null
        : (_s.data --> predicate)
        ? _s.data
        : (_s.next as iterator --> internal)
    ;

    _s --> internal
  ;

  let [test="std_iterator finds an entry"] =
    {
      actual = [1, 2, 3]
        --> iterator_fromArray
        --> ({ predicate = let (_s: int) = _s == 2; } -> iterator_find),
      expected = 2,
    }
  ;
}
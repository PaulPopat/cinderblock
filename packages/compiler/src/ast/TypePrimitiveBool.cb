namespace cinder_ast {
  struct TypePrimitiveBool : TypePrimitive
    is_bool: bool
  ;

  let
    [parses="type", match="^bool$", chainable="false", priority="150"]
    TypePrimitiveBool_Parse (
      _s: TokenWalker,
      parent: EntryParent,
      left: Type | null
    ): TypePrimitiveBool
  =
      let walker = _s;
      let final =
        _s
          --> (
            {
              expected = ["bool"],
              typeName = TokenTypeName.Operator,
            } -> TokenWalker_Expect
          )
          --> TokenWalker_Finish
      ;
    {
      range = _s.range,
      done = final.walker,
      errors = [],
      is_type = true,
      is_primitive = true,
      is_bool = true,
    }
  ;
}
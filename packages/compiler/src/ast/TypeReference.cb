namespace cinder_ast {
  struct TypeReference : Type
    is_reference: bool
    name: string
    generics: TypeArg[]
  ;

  let
    [parses="type", match="^[a-zA-Z][a-zA-Z0-9_@$#:]*$", chainable="false", priority="1"]
    TypeReference_Parse (
      _s: TokenWalker,
      parent: EntryParent,
      left: Type | null
    ): TypeReference
  =
      let walker = _s;
      let final =
        _s
          -->
            {
              property = "name",
              typeName = TokenTypeName.Operator,
            }
            -> TokenWalker_Text
          --> { start = "<", end = ">" }
            -> TypeArg_ParseArray
          --> TokenWalker_Finish
      ;
      let name = final.ctx --> { key = "name" } -> dictionary_get;
      let generics = final.ctx --> { key = "args" } -> dictionary_get;

    {
      range = _s.range,
      done = final.walker,
      errors =
        (
          name |
            let (_s: null) = [{ range = walker.range, message = "No name" }];
            let (_s: string) = NoErrors;
        ) ++
        (
          generics |
            let (_s: null) = NoErrors;
            let (_s: TypeArg[]) = _s --> utils_EntryArrayErrors;
        ),
      is_type = true,
      is_reference = true,
      generics = generics |
        let (_s: null): TypeArg[] = [];
        let (_s: TypeArg[]) = _s;,
      name = name,
    }
  ;
}
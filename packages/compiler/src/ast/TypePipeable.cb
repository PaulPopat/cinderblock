namespace cinder_ast {
  use cinder_tokeniser;

  struct TypePipeable : Type
    is_pipeable: bool
    args: TypeArg[]
    returns: Type
  ;

  let
    [parses="type", match="^\\($", chainable="false", priority="100"]
    TypePipeable_Parse (
      _s: TokenWalker,
      parent: EntryParent,
      left: Type | null
    ): TypePipeable
  =
      let walker = _s;
      let final =
        _s
          --> { start = "(", end = ")" }
            -> TypeArg_ParseArray
          --> (
            {
              expected = [":"],
              typeName = TokenTypeName.Operator,
            } -> TokenWalker_Expect
          )
          --> (
            {
              name = "returns",
              extractor =
                let (_s: TokenWalker, so_far: dictionary): ExtractResult =
                  _s --> ({ parent = parent } -> Type_Parse)
                ;
            } -> TokenWalker_Extract
          )
          --> TokenWalker_Finish
      ;

      let returns = final.ctx --> ({ key = "returns" } -> dictionary_get);
      let args = final.ctx --> ({ key = "args" } -> dictionary_get);
    {
      range = _s.range,
      done = final.walker,
      errors =
        (
          returns |
            let (_s: Type) = _s.errors;
            let (_s: null) = [{ range = walker.range, message = "Return type required" }];
        ) ++
        (
          args |
            let (_s: Type[]) = _s --> utils_EntryArrayErrors;
            let (_s: null) = NoErrors;
        ),
      is_type = true,
      is_pipeable = true,
      args = args |
        let (_s: null) = [];
        let (_s: Type[]) = _s;,
      returns = returns |
        let (_s: null) = null;
        let (_s: Type) = _s;,
    }
  ;
}
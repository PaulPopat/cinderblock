namespace cinder_ast {
  use std;
  use cinder_tokeniser;

  struct TypeArg : Type
    is_arg: bool
    type: Type
    name: string
  ;

  let TypeArg_Parse (
    _s: TokenWalker,
    parent: EntryParent
  ): TypeArg
  =
      let walker = _s;
      let final =
        _s
          --> (
            {
              property = "name",
              typeName = TokenTypeName.PropertyName,
            } -> TokenWalker_Text
          )
          --> (
            {
              predicate = let (_s: TokenWalker) = _s.text == ":";,
              extractor =
                let (_s: TokenWalker) =
                  _s
                  --> (
                    {
                      expected = [":"],
                      typeName = TokenTypeName.Punctuation,
                    } -> TokenWalker_Expect
                  )
                  --> (
                    {
                      name = "type",
                      extractor =
                        let (_s: TokenWalker, so_far: dictionary): ExtractResult =
                          _s --> ({ parent = parent } -> Type_Parse)
                        ;
                    } -> TokenWalker_Extract
                  )
                ;
            } -> TokenWalker_If
          )
          --> TokenWalker_Finish
      ;

      let type =
        final.ctx as dictionary<T: Type>
        --> { key = "type" }
        -> dictionary_get<T: Type>
      ;
    {
      range = _s.range,
      done = final.walker,
      errors =
        (
          type |
            let (_s: Type) = _s.errors;
            let (_s: null) = [];
        ),
      is_type = true,
      is_arg = true,
      name = final.ctx as dictionary<T: string> --> ({ key = "name" } -> dictionary_get<T: string>),
      type = 
        (
          type |
            let (_s: Type) = _s;
            let (_s: null) = {};
        )
    }
  ;

  let TypeArg_ParseArray (_s: TokenWalker, start: string, end: string) =
      let is_arg_next (_s: TokenWalker) =
        (_s.text == ",") ||
        (_s.text == start) && 
        (
          (
            _s -->
              {
                expected = [start, ","],
                typeName = TokenTypeName.Operator,
              }
              -> TokenWalker_Expect
          ).text != end
        )
      ;
      let extract_arg (_s: TokenWalker): ExtractResult =
        _s
          --> 
            {
              expected = [start, ","],
              typeName = TokenTypeName.Operator,
            }
            -> TokenWalker_Expect
          --> TypeArg_Parse
      ;

      let arg_extractor (_s: TokenWalker) =
        _s
          --> 
            {
              name = "args",
              predicate = is_arg_next,
              extractor = extract_arg,
            }
            -> TokenWalker_While
      ;

    _s
      --> 
        {
          predicate = let (_s: TokenWalker) = _s.text == start;,
          extractor = arg_extractor,
        }
        -> TokenWalker_If
      -->
        {
          expected = [end],
          typeName = TokenTypeName.Operator,
        }
        -> TokenWalker_Expect
  ;
}
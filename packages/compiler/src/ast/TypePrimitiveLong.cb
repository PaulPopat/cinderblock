namespace cinder_ast {
  struct TypePrimitiveLong : TypePrimitive
    is_long: bool
  ;

  let
    [parses="type", match="^long$", chainable="false", priority="150"]
    TypePrimitiveLong_Parse (
      _s: TokenWalker,
      parent: EntryParent,
      left: Type | null
    ): TypePrimitiveLong
  =
      let walker = _s;
      let final =
        _s
          --> (
            {
              expected = ["long"],
              typeName = TokenTypeName.Operator,
            } -> TokenWalker_Expect
          )
          --> TokenWalker_Finish
      ;
    {
      range = _s.range,
      done = final.walker,
      errors = [],
      is_type = true,
      is_primitive = true,
      is_long = true,
    }
  ;
}
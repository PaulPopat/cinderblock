namespace cinder_ast {
  struct TypePrimitiveChar : TypePrimitive
    is_char: bool
  ;

  let
    [parses="type", match="^char$", chainable="false", priority="150"]
    TypePrimitiveChar_Parse (
      _s: TokenWalker,
      parent: EntryParent,
      left: Type | null
    ): TypePrimitiveChar
  =
      let walker = _s;
      let final =
        _s
          --> (
            {
              expected = ["char"],
              typeName = TokenTypeName.Operator,
            } -> TokenWalker_Expect
          )
          --> TokenWalker_Finish
      ;
    {
      range = _s.range,
      done = final.walker,
      errors = [],
      is_type = true,
      is_primitive = true,
      is_char = true,
    }
  ;
}
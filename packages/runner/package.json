{
  "name": "@cinderblock-lang/runner",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "emsdk": "docker run --rm -v $(pwd):$(pwd) -u $(id -u):$(id -g) -w $(pwd) emscripten/emsdk",
    "compile:start": "npm run emsdk emcmake cmake . -B build",
    "compile:finish": "npm run emsdk emmake make",
    "compile": "npm run compile:start && npm run compile:finish"
  },
  "repository": "https://github.com/PaulPopat/cinderblock",
  "version": "0.0.2",
  "type": "module",
  "description": "The runner for the CinderBlock programming language",
  "author": "Paul Popat",
  "devDependencies": {},
  "imports": {
    "#variable": "./src/variable/index.ts",
    "#project": "./src/project/index.ts",
    "#app": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "prettier": {
    "printWidth": 150
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "cbrun": "./bin/runner.ts"
  }
}

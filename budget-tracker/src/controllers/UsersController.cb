let
[type="handler", method="GET", path="/users/:user_id"]
controllers_UsersController_GetUsers (params: unknown) =
    use users;
  {
    status = 200,
    body = params.user_id -> getUser
  };

struct controllers_UsersController_PostUsersBody
  email: string
  password: string;

let
[type="handler", method="POST", path="/users"]
controllers_UsersController_PostUsers (body: PostUsersBody) = 
    use services_PasswordService;
    use users;
    use crypto;
    let id = {} -> guid;
  {
    response = {
      status = 200,
      body = { message = "success" }
    },
    updates = {
      addUser = {
        id = id,
        email = body.email,
        password = body.password -> HashPassword
      }
    }
  };
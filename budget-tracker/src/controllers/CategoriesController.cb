namespace controllers_CategoriesController {
  use services;

  let [type="handler", method="GET", path="/app/categories"] GetCategories (cookies: AppCookies) =
    {
      status = 200,
      body = {
        name = "categories",
        data = {
          categories = Categories_List,
        },
      } -> html_template,
      headers = {
        "Content-Type" = "text/html",
      },
    };

  struct PostCategoriesBody
    title: string;

  let [type="handler", method="POST", path="/app/categories"] PostCategory (body: PostCategoriesBody, now: int) =
    {
      response = {
        status = 303,
        body = { message = "Category Created" },
        headers = { location = "/app/categories" },
      },
      updates = {
        database_execute = [
          {
            id = {} -> crypto_guid,
            title = body.title,
            now = now,
          } -> Categories_AddQuery
        ],
      },
    };
}
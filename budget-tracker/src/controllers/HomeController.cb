struct controllers_HomeController_GetHomeQuery
  check_inbox: string;

let
[type="handler", method="GET", path="/"]
controllers_HomeController_GetHome (query: GetHomeQuery, cookies: AppCookies) =
    use services;
  {
    status = 200,
    body = {
      name = "home",
      data = {
        check_inbox = "check_inbox" in query ? query.check_inbox == "true" : false,
        user_id = { _s = cookies } -> CookiesService_GetUserId
      }
    } -> html_template,
    headers = {
      "Content-Type" = "text/html"
    }
  };

let
[type="middleware", path="/app"]
controllers_HomeController_Authorise (cookies: AppCookies) =
  use services;
  {
    user_id = { _s = cookies } -> CookiesService_GetUserId
  };

struct controllers_HomeController_GetRegisterProps
  token: string;

let
[type="handler", method="GET", path="/register"]
controllers_HomeController_GetRegister (query: GetRegisterProps) = {
  status = 200,
  body = { name = "register", data = { token = query.token } } -> html_template,
  headers = {
    "Content-Type" = "text/html"
  }
};
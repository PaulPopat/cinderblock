namespace controllers_HomeController {
  extern html_template (name: string, data: unknown): string;

  use services;

  struct GetHomeQuery
    check_inbox: string;

  let [type="handler", method="GET", path="/"] GetHome (query: GetHomeQuery, cookies: AppCookies) =
    {
      status = 200,
      body = {
        name = "home",
        data = {
          check_inbox = "check_inbox" in query ? query.check_inbox == "true" : false,
          user = { _s = cookies } -> Cookies_User
        }
      } -> html_template,
      headers = {
        "Content-Type" = "text/html"
      }
    };

  let [type="middleware", path="/app"] Authorise (cookies: AppCookies) =
      let user = { _s = cookies } -> Cookies_User;
    "id" in user
      ? {
        user = user,
      }
      : {
        status = 401,
        body = "Invalid User"
      };

  struct GetRegisterProps
    token: string;

  let [type="handler", method="GET", path="/register"] GetRegister (query: GetRegisterProps) = {
    status = 200,
    body = { name = "register", data = { token = query.token } } -> html_template,
    headers = {
      "Content-Type" = "text/html"
    }
  };
}
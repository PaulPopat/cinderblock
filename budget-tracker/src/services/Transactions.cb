namespace services_Transactions {
  extern database_query (sql: string, parameters: unknown[]): string;
  
  let List (from: int, to: int): Transaction[] =
    {
      sql = "select * from transactions where created_at > ? and created_at < ?",
      parameters = [from, to],
    } -> database_query;

  let AddQuery (
    id: string,
    user_id: string,
    title: string,
    category_id: string,
    amount: int,
    now: int
  ) =
    {
      sql = "INSERT INTO transactions (id, user, title, category, amount, created_at) VALUES (?, ?, ?, ?, ?, ?)",
      parameters = [id, user_id, title, category, amount, now]
    };
}
let services_UsersService_GetUserByEmail (_s: string) =
  {
    _s =  {
      sql = "SELECT * FROM users WHERE email = ?",
      parameters = [_s]
    } -> database_query,
    i = 0
  } -> std_array_get;

let services_UsersService_AddUserQuery (
  id: string,
  email: string,
  password: string,
  created: string
) =
  {
    sql = "INSERT INTO users (id, email, hashed_password, created_at, updated_at) VALUES (?, ?, ?, ?, ?)",
    parameters = [id, email, password, created, created]
  };
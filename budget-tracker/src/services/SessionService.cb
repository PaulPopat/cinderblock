let services_SessionService_CreateUserIdCookie (_s: string, now: int) =
   "session=" + ({
      user_id = _s,
      exp = (now / 1000) + (60 * 60)
    } -> jwt_encode);

let services_SessionService_GetUserId (_s: string) =
    struct SessionToken user_id: string;
  ((_s -> jwt_verify) as SessionToken).user_id;

let services_SessionService_CreateRegisterCookie (_s: string, now: int) =
   {
      email = _s,
      exp = (now / 1000) + (60 * 60)
    } -> jwt_encode;

let services_SessionService_GetRegisterEmail (_s: string) =
    struct RegisterToken email: string;
  ((_s -> jwt_verify) as RegisterToken).email;

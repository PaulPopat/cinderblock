namespace services_Password {
  extern crypto_scrypt (_s: string, salt: string, keylen: int): string;
  extern crypto_bytes (_s: int): string;
  extern crypto_timingSafeEqual (left: string, right: string): boolean;
  extern std_array_get (_s: string[], i: int): string;
  extern std_string_split (_s: string[], on: string): string[];

  let hashOnSalt (input: string, salt: string) =
    { _s = input, salt = salt, keylen = 64 } -> crypto_scrypt;

  let embedSalt (encrypted: string, salt: string) =
    encrypted + "." + salt;

  let extractSalt (_s: string) =
      let splitResult = { _s = _s, on = "." } -> std_string_split;
    {
      salt = { _s = splitResult, i = 1 } -> std_array_get,
      hash = { _s = splitResult, i = 0 } -> std_array_get
    };

  let Hash (_s: string) =
      let salt = 16 -> crypto_bytes;
    {
      encrypted = { input = _s, salt = salt } -> hashOnSalt,
      salt = salt
    } -> embedSalt;

  let Matches (original: string, _s: string) =
      let parts = original -> extractSalt;
    {
      left = parts.hash,
      right = { input = _s, salt = parts.salt } -> hashOnSalt
    } -> crypto_timingSafeEqual;
}
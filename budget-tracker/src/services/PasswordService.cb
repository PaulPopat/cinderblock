let services_PasswordService_HashPassword (_s: string) =
    use crypto;
    let salt = 16 -> bytes;
    let buf = { _s = _s, salt = salt, keylen = 64 } -> scrypt;
  buf + "." + salt;

let services_PasswordService_Matches (original: string, _s: string) =
    use std;
    use crypto;
    let splitResult = { _s = original, on = "." } -> string_split;
  {
    left = { _s = splitResult, i = 1 } -> array_get,
    right = {
      _s = _s,
      salt = { _s = splitResult, i = 0 } -> array_get,
      keylen = 64
    } -> scrypt
  } -> timingSafeEqual;

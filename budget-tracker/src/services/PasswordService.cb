let services_PasswordService_hashOnSalt (input: string, salt: string) =
  { _s = input, salt = salt, keylen = 64 } -> crypto_scrypt;

let services_PasswordService_embedSalt (encrypted: string, salt: string) =
  encrypted + "." + salt;

let services_PasswordService_extractSalt (_s: string) =
    let splitResult = { _s = _s, on = "." } -> std_string_split;
  {
    salt = { _s = splitResult, i = 1 } -> std_array_get,
    hash = { _s = splitResult, i = 0 } -> std_array_get
  };

let services_PasswordService_HashPassword (_s: string) =
    let salt = 16 -> crypto_bytes;
  {
    encrypted = { input = _s, salt = salt } -> hashOnSalt,
    salt = salt
  } -> embedSalt;

let services_PasswordService_Matches (original: string, _s: string) =
    let parts = original -> extractSalt;
  {
    left = parts.hash,
    right = { input = _s, salt = parts.salt } -> hashOnSalt
  } -> crypto_timingSafeEqual;

namespace services_Categories {
  let List: Category[] =
    {
      sql = "select * from categories",
      parameters = []
    } -> database_query;

  let AddQuery  (
    id: string,
    title: string,
    now: int
  ) =
    {
      sql = "INSERT INTO categories (id, title, created_at, updated_at) VALUES (?, ?, ?, ?)",
      parameters = [id, title, now, now]
    };

  let RenameQuery  (
    id: string,
    title: string,
    now: int
  ) =
    {
      sql = "update categories set title = ?, updated_at = ? where id = ?",
      parameters = [title, now, id]
    };
}
let services_Session_UserIdCookie (_s: string, now: int) =
   "session=" + ({
      user_id = _s,
      exp = (now / 1000) + (60 * 60)
    } -> jwt_encode);

let services_Session_UserId (_s: string) =
    struct SessionToken user_id: string;
    let parsed = (_s -> jwt_verify) as SessionToken;
  "user_id" in parsed ? parsed.user_id : null;

let services_Session_RegisterCookie (_s: string, now: int) =
   {
      email = _s,
      exp = (now / 1000) + (60 * 60)
    } -> jwt_encode;

let services_Session_RegisterEmail (_s: string) =
    struct RegisterToken email: string;
  (_s -> jwt_verify as RegisterToken).email;

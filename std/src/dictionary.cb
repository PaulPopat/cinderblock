namespace std {
  struct dictionary_entry
    key: string
    value: T
  ;

  struct dictionary
    data: iterator<T: dictionary_entry<T: T>>
  ;

  let dictionary_create: dictionary<T: T> =
    {
      data = [] -> iterator_fromArray<T: dictionary<T: T>[]>,
    }
  ;

  let dictionary_set (_s: dictionary<T: T>, key: string, value: T): dictionary<T: T> =
    {
      data =
        {
          _s = _s.data,
          predicate = let (_s: struct key: string ;) = _s.key != key;,
        }
        -> iterator_where<T: DictionaryEntry<T: T>[]>
        --> ({ addition = { key = key, value = value } } -> iterator_concat),
    }
  ;

  let dictionary_get (_s: dictionary<T: T>, key: string) =
      let result = 
        {
          _s = _s.data,
          predicate = let (_s: dictionary_entry<T: T>) = _s.key == key;,
        }
        -> iterator_find<T: dictionary_entry<T: T>>
      ;
    "value" in result ? result.value : null
  ;

  let [test="std_dictionary creates and updates dictionary items"] =
    {
      actual = dictionary_create<T: string>
        --> ({key = "test1", value = "hello" } -> dictionary_set<T: string>)
        --> ({key = "test2", value = "world" } -> dictionary_set<T: string>)
        --> ({key = "test3", value = "from" } -> dictionary_set<T: string>)
        --> ({key = "test4", value = "paul" } -> dictionary_set<T: string>)
        --> ({key = "test2"} -> dictionary_get<T: string>),
      expected = "world",
    }
  ;
}
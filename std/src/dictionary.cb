namespace std {
  struct dictionary_entry
    key: string
    value: T
  ;

  struct dictionary
    data: iterator<T: dictionary_entry<T: T>>
  ;

  let dictionary_create: dictionary<T: T> =
    {
      data = [] -> iterator_fromArray<T: dictionary<T: T>[]>,
    }
  ;

  let dictionary_set (_s: dictionary<T: T>, key: string, value: T): dictionary<T: T> =
    {
      data =
        {
          _s = _s.data,
          predicate = let (item: struct key: string ;) = item.key != key;,
        }
        -> iterator_where<T: DictionaryEntry<T: T>[]>
        --> ({ addition = { key = key, value = value } } -> iterator_concat),
    }
  ;

  let dictionary_get (_s: dictionary<T: T>, key: string) =
    (
      {
        _s = _s.data,
        predicate = let (item: dictionary_entry<T: T>) = item.key != key;,
      }
      -> iterator_find<T: dictionary_entry<T: T>>
    )
    .value
  ;
}
namespace std {
  struct iterator
    data: T
    next: unknown
    done: bool
  ;

  let iterator_next (_s: iterator<T: T>): iterator<T: T> =
    _s.done ? { data = null as T, next = null, done = true } : _s.next
  ;

  let iterator_fromArray (_s: T[]): iterator<T: T> =
      let internal (index: int): iterator<T: T> =
          let data =  _s @ index;
          let done = null == data;
        {
          data = data,
          next = !done ? { index = index + 1 } -> internal : null,
          done = done,
        }
      ;
    { index = 0 } -> internal
  ;

  let [test="std_iterator creates an iterator from an array"] =
    {
      actual = [1, 2, 3]
        -> iterator_fromArray<T: int>
        --> ({
          initial = 0,
          reducer = let (_s: int, current: int) = _s + current;,
        } -> iterator_reduce<T: int>),
      expected = 6,
    }
  ;

  let iterator_reduce (
    _s: iterator<T: T>,
    initial: TResult,
    reducer: (_s: T, current: TResult): TResult
  ): TResult =
    let internal (current: TResult, entry: iterator<T: T>):
      struct
        current: TResult
        entry: iterator<T: T>
      ;
    =
      entry.done
        ? {
            current = current,
            entry = entry,
          }
        : {
            current = { _s = entry.data, current = current } -> reducer,
            entry = entry --> iterator_next<T: T>
          } -> internal
    ;

    (
      { current = initial, entry = _s } -> internal
    ).current
  ;

  let iterator_select (
    _s: iterator<T: T>,
    selector: (_s: T): TResult
  ): iterator<T: TResult> =
    {
      data = !_s.done ? _s.data -> selector : null,
      next = !_s.done
        ? { _s = _s --> iterator_next<T: T>, selector = selector } -> iterator_select<T: T>
        : null,
      done = _s.done,
    }
  ;

  let [test="std_iterator selects over an iterator"] =
    {
      actual = [1, 2, 3]
        -> iterator_fromArray<T: int>
        --> ({
          selector = let (_s: int) = _s + 1;,
        } -> iterator_select<T: int, TResult: int>)
        --> iterator_toArray<T: int>,
      expected = [2, 3, 4],
    }
  ;

  let iterator_where (
    _s: iterator<T: T>,
    predicate: (_s: T): bool
  ): iterator<T: T> =
    _s.done
      ? _s
      : _s.data --> predicate
      ? _s
      : _s.next --> ({ predicate = predicate } -> iterator_where)
  ;

  let iterator_concat (
    _s: iterator<T: T>,
    addition: T
  ): iterator<T: T> =
    _s.done
      ? {
          data = addition,
          done = false,
          next = {
            done = true,
            data = null,
            next = null,
          },
        }
      : {
          ..._s,
          next = { _s = _s --> iterator_next<T: T>, addition = addition } -> iterator_concat,
        }
  ;

  let [test="std_iterator adds an entry"] =
    {
      actual = [1, 2, 3]
        --> iterator_fromArray
        --> ({ addition = 4 } -> iterator_concat)
        --> iterator_toArray,
      expected = [1, 2, 3, 4],
    }
  ;

  let iterator_length (
    _s: iterator<T: unknown>
  ): int =
    {
      _s = _s,
      initial = 0,
      reducer = let (current: int, _s: unknown) = current + 1;
    } -> iterator_reduce<T: unknown, TResult: int>
  ;

  let [test="std_iterator gets the length"] =
    {
      actual = [1, 2, 3]
        --> iterator_fromArray
        --> iterator_length,
      expected = 3,
    }
  ;

  let iterator_toArray (
    _s: iterator<T: T>
  ) =
    {
      _s = _s,
      initial = [] as T[],
      reducer = let (_s: T, current: T[]) = current ++ _s;,
    } -> iterator_reduce<T: unknown, TResult: T[]>
  ;

  let iterator_some (
    _s: iterator<T: T>,
    predicate: (_s: T): bool
  ) =

    _s.done
      ? false
      : (_s.data --> predicate) ||
        ({ _s = _s --> iterator_next, predicate = predicate } -> iterator_some)
  ;

  let [test="std_iterator matches against some"] =
    {
      actual = [1, 2, 3]
        --> iterator_fromArray
        --> ({ predicate = let (_s: int) = _s == 2; } -> iterator_some<T: int>),
      expected = true,
    }
  ;

  let [test="std_iterator matches missing against some"] =
    {
      actual = [1, 2, 3]
        --> iterator_fromArray
        --> ({ predicate = let (_s: int) = _s == 4; } -> iterator_some<T: int>),
      expected = false,
    }
  ;

  let iterator_find (
    _s: iterator<T: T>,
    predicate: (_s: T): bool
  ) =
    let internal (_s: iterator<T: T>): T =
       _s.done ? null : (_s.data --> predicate) ? _s.data : (_s.next --> internal)
    ;

    _s --> internal
  ;

  let [test="std_iterator finds an entry"] =
    {
      actual = [1, 2, 3]
        --> iterator_fromArray
        --> ({ predicate = let (_s: int) = _s == 2; } -> iterator_find<T: int>),
      expected = 2,
    }
  ;
}
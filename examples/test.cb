let namespace:segment:start 10;

let namespace:segment:end 20;

let app:main (string command)
  use namespace;

  struct TestStruct
    int first
    string second;

  let test_func (TestStruct subject, float thing, int second): int
    subject.second == "add"
      ? subject.first + second
      : subject.first - second;

  let start first = segment:start, second = command;

  let curried second = segment:end -> test_func;

  subject = start, thing = 20.0f -> curried;
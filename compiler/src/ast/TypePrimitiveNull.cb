namespace cinder_ast {
  struct TypePrimitiveNull : TypePrimitive
    is_null: bool
  ;

  let
    [parses="type", match="^null$", chainable="false", priority="150"]
    TypePrimitiveNull_Parse (
      _s: TokenWalker,
      parent: EntryParent,
      left: Type | null
    ): TypePrimitiveNull
  =
      let walker = _s;
      let final =
        _s
          --> (
            {
              expected = ["null"],
              typeName = TokenTypeName.Operator,
            } -> TokenWalker_Expect
          )
          --> TokenWalker_Finish
      ;
    {
      range = _s.range,
      done = final.walker,
      errors = [],
      is_type = true,
      is_primitive = true,
      is_null = true,
    }
  ;
}
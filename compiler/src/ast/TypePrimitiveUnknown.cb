namespace cinder_ast {
  struct TypePrimitiveUnknown : TypePrimitive
    is_unknown: bool
  ;

  let
    [parses="type", match="^unknown$", chainable="false", priority="150"]
    TypePrimitiveUnknown_Parse (
      _s: TokenWalker,
      parent: EntryParent,
      left: Type | null
    ): TypePrimitiveUnknown
  =
      let walker = _s;
      let final =
        _s
          --> (
            {
              expected = ["unknown"],
              typeName = TokenTypeName.Operator,
            } -> TokenWalker_Expect
          )
          --> TokenWalker_Finish
      ;
    {
      range = _s.range,
      done = final.walker,
      errors = [],
      is_type = true,
      is_primitive = true,
      is_unknown = true,
    }
  ;
}
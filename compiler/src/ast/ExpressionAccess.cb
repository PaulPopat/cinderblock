namespace cinder_ast {
  use cinder_tokeniser;

  struct ExpressionAccess : Expression
    is_access: bool
    subject: Expression
    name: string
  ;

  let
    [parses="expression", match="^\\.$", inone="true", priority="100"]
    ExpressionAccess_Parse (
      _s: TokenWalker,
      parent: EntryParent,
      lookFor: string[],
      existing: Expression | null
    ): ExpressionAccess
  =
      let walker = _s;
      let final =
        _s
          --> (
            {
              expected = ["."],
              typeName = TokenTypeName.Operator,
            } -> TokenWalker_Expect
          )
          --> (
            {
              property = "name",
              typeName = TokenTypeName.Operator,
            } -> TokenWalker_Text
          )
          --> TokenWalker_Finish
      ;
    {
      range = _s.range,
      done = final.walker,
      errors = existing |
        let (_s: Expression) = _s.errors;
        let (_s: null) = [{ range = walker.range, message = "Left required" }];,
      is_access = true,
      is_expression = true,
      subject = existing as Expression,
      name = final.ctx as dictionary<T: string>
        --> { key = "name" }
        -> dictionary_get<T: string>,
    }
  ;

  let
    [test="cinder_ast parses an access expression"]
  =
      let sut = { file = "hello", text = ".test" }
        -> Tokenise
        --> TokenWalker_Start
        --> (
          {
            parent = null as EntryParent,
            lookFor = [] as string[],
            existing = "hello world" as Expression,
          } -> ExpressionAccess_Parse
        )
      ;
    {
      actual = {
        is_access = sut.is_access,
        subject = sut.subject,
        name = sut.name,
      },
      expected = {
        is_access = true,
        subject = "hello world",
        name = "test",
      },
    }
  ;
}
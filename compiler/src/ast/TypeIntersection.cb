namespace cinder_ast {
  use std;
  use cinder_tokeniser;

  struct TypeIntersection : Type
    is_intersection: bool
    parts: Type[]
  ;

  let
    [parses="type", match="^\\&$", chainable="true", priority="100"]
    TypeIntersection_Parse (
      _s: TokenWalker,
      parent: EntryParent,
      left: Type | null
    ): TypeIntersection
  =
      let walker = _s;
      let final =
        _s
          --> (
            {
              expected = ["&"],
              typeName = TokenTypeName.Operator,
            } -> TokenWalker_Expect
          )
          --> (
            {
              name = "right",
              extractor =
                let (_s: TokenWalker, so_far: dictionary): ExtractResult =
                  _s --> (
                    {
                      parent = { float = parent.float, dig = parent.dig }
                    } -> Type_Parse
                  )
                ;
            } -> TokenWalker_Extract
          )
          --> TokenWalker_Finish
      ;

      let right = final.ctx --> ({ key = "right" } -> dictionary_get<T: string>);

      let parse_left_intersection (_s: TypeIntersection) =
          let left = _s;
        right |
          let (_s: Type) = left.parts ++ _s;
          let (_s: TypeIntersection) = left.parts ++ _s.parts;
      ;

      let parse_left_other (_s: TypeIntersection) =
          let left = _s;
        right |
          let (_s: Type) = [left] ++ _s;
          let (_s: TypeIntersection) = [left] ++ _s.parts;
      ;
    {
      range = _s.range,
      done = final.walker,
      errors =
        (
          left |
            let (_s: Type) = _s.errors;
            let (_s: null) = [{ range = walker.range, message = "Left required" }];
        ) ++
        (
          right |
            let (_s: Type) = _s.errors;
            let (_s: null) = [{ range = walker.range, message = "Right required" }];
        ),
      is_type = true,
      is_intersection = true,
      parts = left |
        let (_s: Type) = _s --> parse_left_other;
        let (_s: TypeIntersection) = _s --> parse_left_intersection;
    }
  ;
}
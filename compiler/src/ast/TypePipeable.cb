namespace cinder_ast {
  use cinder_tokeniser;

  struct TypePipeable : Type
    is_pipeable: bool
    args: TypeArg[]
    returns: Type
  ;

  let
    [parses="type", match="^\\($", chainable="false", priority="100"]
    TypePipeable_Parse (
      _s: TokenWalker,
      parent: EntryParent,
      left: Type | null
    ): TypePipeable
  =
      let walker = _s;
      let final =
        _s
          --> (
            {
              name = "args",
              predicate = let (_s: TokenWalker) =
                (_s.text == ",") ||
                (_s.text == "(") && 
                (
                  (
                    _s --> (
                      {
                        expected = ["[]"],
                        typeName = TokenTypeName.Operator,
                      } -> TokenWalker_Expect
                    )
                  ).text != ")"
                )
              ;,
              extractor =
                let (_s: TokenWalker): ExtractResult =
                  _s --> TypeArg_Parse
                ;,
            } -> TokenWalker_While
          )
          --> (
            {
              predicate = let (_s: TokenWalker) = _s.text == "(";,
              extractor =
                let (_s: TokenWalker) =
                  _s
                  --> (
                    {
                      expected = ["("],
                      typeName = TokenTypeName.Punctuation,
                    } -> TokenWalker_Expect
                  )
                ;
            } -> TokenWalker_If
          )
          --> (
            {
              expected = [")"],
              typeName = TokenTypeName.Operator,
            } -> TokenWalker_Expect
          )
          --> (
            {
              expected = [":"],
              typeName = TokenTypeName.Operator,
            } -> TokenWalker_Expect
          )
          --> (
            {
              name = "returns",
              extractor =
                let (_s: TokenWalker, so_far: dictionary): ExtractResult =
                  _s --> ({ parent = parent } -> Type_Parse)
                ;
            } -> TokenWalker_Extract
          )
          --> TokenWalker_Finish
      ;

      let returns = final.ctx --> ({ key = "returns" } -> dictionary_get);
      let args = final.ctx --> ({ key = "args" } -> dictionary_get);
    {
      range = _s.range,
      done = final.walker,
      errors =
        (
          returns |
            let (_s: Type) = _s.errors;
            let (_s: null) = [{ range = walker.range, message = "Return type required" }];
        ) ++
        (
          args |
            let (_s: Type[]): CompilerError[] =
              _s
              --> iterator_fromArray<T: Type>
              --> (
                { selector = let (_s: Type) = _s.errors --> iterator_fromArray<T: CompilerError>; }
                -> iterator_select<T: Type, TResult: iterator<T: CompilerError>>
              )
              --> iterator_flatten<T: CompilerError>
              --> iterator_toArray<T: CompilerError>
            ;
            let (_s: null) = [];
        ),
      is_type = true,
      is_pipeable = true,
      args = args |
        let (_s: null) = [];
        let (_s: Type[]) = _s;,
      returns = returns |
        let (_s: null) = null;
        let (_s: Type) = _s;,
    }
  ;
}
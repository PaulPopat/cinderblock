namespace cinder_ast {
  use cinder_tokeniser;

  struct TypePipeable : Type
    is_pipeable: bool
    args: TypeArg[]
    returns: Type
  ;

  let
    [parses="type", match="^\\($", chainable="false", priority="100"]
    TypePipeable_Parse (
      _s: TokenWalker,
      parent: EntryParent,
      left: Type | null
    ): TypePipeable
  =
      let walker = _s;
      let final =
        _s
          --> (
            {
              expected = ["[]"],
              typeName = TokenTypeName.Operator,
            } -> TokenWalker_Expect
          )
          --> TokenWalker_Finish
      ;
    {
      range = _s.range,
      done = final.walker,
      errors = left |
        let (_s: Type) = _s.errors;
        let (_s: null) = [{ range = walker.range, message = "Left required" }];,
      is_type = true,
      is_pipeable = true,
      contains = left as Type,
    }
  ;
}
namespace cinder_ast {
  struct TypePrimitiveString : TypePrimitive
    is_string: bool
  ;

  let
    [parses="type", match="^string$", chainable="false", priority="150"]
    TypePrimitiveString_Parse (
      _s: TokenWalker,
      parent: EntryParent,
      left: Type | null
    ): TypePrimitiveString
  =
      let walker = _s;
      let final =
        _s
          --> (
            {
              expected = ["string"],
              typeName = TokenTypeName.Operator,
            } -> TokenWalker_Expect
          )
          --> TokenWalker_Finish
      ;
    {
      range = _s.range,
      done = final.walker,
      errors = [],
      is_type = true,
      is_primitive = true,
      is_string = true,
    }
  ;
}
let Tokens_Tokeniser (file: string, text: string) =
  use std;

  struct TokeniserContext
    tokens: Token[],
    current: string,
    location: Location;

  let allowedLiterals = [
    "[]",
    "[",
    "]",
    "(",
    ")",
    ":",
    "+",
    "++",
    "-",
    "/",
    "*",
    "!",
    "&&",
    "||",
    "==",
    "=",
    "!=",
    "<",
    "<=",
    ">",
    ">=",
    ".",
    "->"
  ];

  let patterns = [
    "^[a-zA-Z0-9_@$#]+$",
    "^[0-9]+\.[0-9]*[a-z]?$",
    "^\"[^\"]*\"?$",
    "^'[^']?'?$",
    "^'\\.?'?$"
  ];

  let isMatchLiteral (subject: string, value: string) = subject == value;

  let isValid (subject: string) =
    let curriedRegex = {subject = subject} -> regex_match;
    let curriedMatch = {subject = subject} -> isMatchLiteral;

    {predicate = curriedRegex, subject = patterns} -> array_find != null ||
    {predicate = curriedMatch, subject = allowedLiterals} -> array_find != null;

  let onCharacter (lineNumber: int, next: string, total: TokeniserContext, index: int) =
    let current = total.current + next;

    { subject = current } -> isValid
      ? {
        tokens = total.tokens,
        current = current,
        location = total.location
      } : {
        tokens = { subject = current } -> string_trim != ""
          ? total.tokens ++ {
              data = current,
              location = total.location
            }
          : total.tokens,
        current = "",
        location = {
          file = total.location.file,
          lineNumber = lineNumber + 1,
          characterNumber = index + 1
        }
      };

  let onLine (next: string, total: TokeniserContext, index: int) =
    {
      subject = {subject = next, on = ""} -> string_split,
      reducer = {lineNumber = index} -> onCharacter,
      initial = total
    } -> array_reduce;
  
  (
    {
      subject = {subject = text, on = "\n"} -> string_split,
      reducer = onLine,
      initial = {
        tokens = [],
        current = "",
        location = {
          file = total.location.file,
          lineNumber = 0,
          characterNumber = 0
        }
      }
    } -> array_reduce
  ).tokens;
  
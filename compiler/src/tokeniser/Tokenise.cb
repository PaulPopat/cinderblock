namespace cinder_tokeniser {
  extern std_string_matches (_s: string, pattern: string): bool;
  extern std_string_split (_s: string, on: string): string[];

  let Tokenise (file: string, text: string) =
      let line_split = { on = "\n" } -> std_string_split;

      let allowedLiterals = [
        "[]",
        "[",
        "]",
        "(",
        ")",
        ":",
        "+",
        "++",
        "-",
        "/",
        "*",
        "!",
        "&&",
        "||",
        "==",
        "=",
        "!=",
        "<",
        "<=",
        ">",
        ">=",
        ".",
        "->",
      ];

      let allowedPatterns = [
        "^[a-zA-Z0-9_@$#]+$",
        "^[0-9]+\\.[0-9]*[a-z]?$",
        "^\"[^\"]*\"?$",
        "^'[^']?'?$",
        "^'\\.?'?$",
      ];

      let lines = text -> line_split;

    "hello";
}
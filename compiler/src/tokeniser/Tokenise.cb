namespace cinder_tokeniser {
  let Tokenise (file: string, text: string) =
      let character_split = { on = "" } -> std_string_split;

      let allowedLiterals = [
        "[]",
        "[",
        "]",
        "(",
        ")",
        ":",
        "+",
        "++",
        "-",
        "/",
        "*",
        "!",
        "&&",
        "||",
        "==",
        "=",
        "!=",
        "<",
        "<=",
        ">",
        ">=",
        ".",
        "..",
        "...",
        "--",
        "-->",
        "->",
        "@",
      ];

      let allowedPatterns = [
        "^[a-zA-Z0-9_@$#]+$",
        "^[0-9]+\\.[0-9]*[a-z]?$",
        "^\"[^\"]*\"?$",
        "^'[^']?'?$",
        "^'\\.?'?$",
      ];

      let isValid (_s: string) =
        (
          {
            predicate = let (item: string) =
              {
                _s = _s,
                pattern = item,
              } -> std_string_matches
            ;,
            _s = allowedPatterns,
          } -> std_array_some
        ) ||
        (
          {
            predicate = let (item: string) = item == _s;,
            _s = allowedLiterals,
          } -> std_array_some
        )
      ;

      struct TokenisationContext
        result: Token[]
        location: Location
        current: string
        line: int
        character: int
      ;

      let process (
        ctx: TokenisationContext,
        character: string
      ) = {
        result =
          ((ctx.current + character) -> isValid) &&
          ((ctx.current + character) -> std_string_trim != "")
            ? ctx.result ++ {
                data = (ctx.current + character),
                range = {
                  from = ctx.location,
                  to = {
                    file = file,
                    line = ctx.line + 1,
                    character = ctx.character + 1,
                  },
                }
              }
            : ctx.result,
        location = {
          file = file,
          line = ctx.line + 1,
          character = ctx.character + 1,
        },
        current = "",
        line = character == "\n" ? ctx.line + 1 : ctx.line,
        character = character == "\n" ? 0 : ctx.character + 1,
      }
    ;

    (
      {
        initial = {
          result = [] as Token[],
          location = { file = file, line = 0, character = 0 },
          current = "",
          line = 0,
          character = 0,
        },
        _s = text -> character_split,
        reducer = let (item: string, current: TokenisationContext) =
          { ctx = current, character = item } -> process
        ;
      } -> std_array_reduce as
      TokenisationContext
    ).result
  ;
}
namespace cinder_tokeniser {
  let Tokenise (file: string, text: string) =
      let allowed_literals = [
        "[]",
        "[",
        "]",
        "(",
        ")",
        ":",
        "+",
        "++",
        "-",
        "/",
        "*",
        "!",
        "&&",
        "||",
        "==",
        "=",
        "!=",
        "<",
        "<=",
        ">",
        ">=",
        ".",
        "->",
      ];

      let allowed_pattersn = [
        "^[a-zA-Z0-9_@$#]+$",
        "^[0-9]+\\.[0-9]*[a-z]?$",
        "^\"[^\"]*\"?$",
        "^'[^']?'?$",
        "^'\\.?'?$",
      ];

    "hello";
}
namespace cinder_tokeniser {
  use std;
  
  let Tokenise (file: string, text: string): iterator<T: Token> =
      let character_split (_s: string) = 
        { on = "", _s = _s }
        -> std_string_split
        -> std_iterator_fromArray<T: string>;

      let allowedLiterals =
        [
          "[]",
          "[",
          "]",
          "(",
          ")",
          ":",
          "+",
          "++",
          "-",
          "/",
          "*",
          "!",
          "&&",
          "||",
          "==",
          "=",
          "!=",
          "<",
          "<=",
          ">",
          ">=",
          ".",
          "..",
          "...",
          "--",
          "-->",
          "->",
          "@",
        ] -> std_iterator_fromArray<T: string>
      ;

      let allowedPatterns =
        [
          "^[a-zA-Z0-9_@$#]+$",
          "^[0-9]+\\.[0-9]*[a-z]?$",
          "^\"[^\"]*\"?$",
          "^'[^']?'?$",
          "^'\\.?'?$",
        ] -> std_iterator_fromArray<T: string>
      ;

      let isValid (_s: string) =
        (
          {
            predicate = let (item: string) =
              {
                _s = _s,
                pattern = item,
              } -> std_string_matches
            ;,
            _s = allowedPatterns,
          } -> std_iterator_some
        ) ||
        (
          {
            predicate = let (item: string) = item == _s;,
            _s = allowedLiterals,
          } -> std_iterator_some
        )
      ;

      struct TokenisationContext
        result: Token[]
        location: Location
        current: string
        line: int
        character: int
      ;

      let process (
        ctx: TokenisationContext,
        character: string
      ): TokenisationContext = {
        result =
          ((ctx.current + character) -> isValid) &&
          ((ctx.current + character) -> std_string_trim != "")
            ? ctx.result ++ {
                data = (ctx.current + character),
                range = {
                  from = ctx.location,
                  to = {
                    file = file,
                    line = ctx.line + 1,
                    character = ctx.character + 1,
                  },
                }
              }
            : ctx.result,
        location = {
          file = file,
          line = ctx.line + 1,
          character = ctx.character + 1,
        },
        current = "",
        line = character == "\n" ? ctx.line + 1 : ctx.line,
        character = character == "\n" ? 0 : ctx.character + 1,
      }
    ;

    (
      {
        initial = {
          result = [] as Token[],
          location = { file = file, line = 0, character = 0 },
          current = "",
          line = 0,
          character = 0,
        },
        _s = text -> character_split,
        reducer = let (_s: string, current: TokenisationContext): TokenisationContext =
          { ctx = current, character = _s } -> process
        ;
      } -> std_iterator_reduce<T: string> as
      TokenisationContext
    )
    .result
    -> std_iterator_fromArray<T: Token>
  ;
}
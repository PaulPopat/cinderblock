namespace cinder_tokeniser {
  use std;
  use cinder_utils;

  struct TokenWalker
    tokens: iterator<T: Token>
    index: int
    current: Token | null
    ctx: dictionary
    text: string
    done: bool
    types: TokenType[]
    range: Range
    errors: CompilerError[]
  ;

  let TokenWalker_Create (
    _s: iterator<T: Token>,
    index: int,
    ctx: unknown,
    types: TokenType[],
    errors: CompilerError[]
  ): TokenWalker =
      let current: Token = !_s.done
        ? _s.data
        : { data = "", range = Range_Empty };
      let range: Range = current.range;

    {
      tokens = _s,
      index = index,
      current = current,
      ctx = ctx,
      text = current.data,
      types = types,
      range = range,
      location = range.from,
      errors = errors,
    }
  ;

  let TokenWalker_Previous (_s: TokenWalker): TokenWalker =
    {
      _s = _s.tokens,
      index = _s.index - 1,
      ctx = _s.ctx,
      types = _s.types,
      errors = _s.errors,
    } -> TokenWalker_Create
  ;

  let TokenWalker_Expect (
    _s: TokenWalker,
    expected: string[],
    typeName: string,
    self: (): unknown
  ): TokenWalker =
    {
      _s = expected,
      predicate = let (item: string) =
        _s.text == item
      ;
    } -> iterator_some
      ? {
        _s = _s.tokens,
        ctx = _s.ctx,
        types = _s.types,
        index = _s.index + 1,
        errors = _s.errors ++ {
          range = _s.range,
          message =
            "Expected " +
            ({ _s = expected, separator = ", " } -> std_string_join) +
            " but found " +
            _s.text,
        },
      } -> TokenWalker_Create
      : {
        _s = _s.tokens,
        index = _s.index + 1,
        ctx = _s.ctx,
        types = _s.types,
        errors = _s.errors,
      } -> TokenWalker_Create
  ;

  struct ExtractResult
    done: TokenWalker
  ;

  let TokenWalker_Extract (
    walker: TokenWalker,
    name: string,
    extractor: (_s: TokenWalker, so_far: Dictionary): ExtractResult
  ) =
      let result = { _s = walker, so_far = walker.ctx } -> extractor;
    {
      ...result.done,
      ctx = { _s = walker.ctx, key = name, value = result } -> dictionary_set
    }
  ;

  let TokenWalker_If (
    walker: TokenWalker,
    predicate: (_s: TokenWalker): bool,
    extractor: (_s: TokenWalker): TokenWalker
  ) = 
    walker --> predicate
      ? walker --> extractor
      : walker
  ;

  let TokenWalker_While (
    _s: TokenWalker,
    name: string,
    extractor: (_s: TokenWalker, so_far: Dictionary): ExtractResult
  ) =
      let result = { _s = _s, so_far = _s.ctx } -> extractor;
    {
      ...result.done,
      ctx = { _s = _s.ctx, key = name, value = result } -> dictionary_set
    }
  ;
}
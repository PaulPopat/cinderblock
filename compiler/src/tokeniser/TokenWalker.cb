namespace cinder_tokeniser {
  use std;
  use cinder_utils;

  struct TokenWalker
    tokens: Token[]
    index: int
    current: Token | null
    ctx: dictionary
    text: string
    done: bool
    types: TokenType[]
    range: Range
    errors: CompilerError[]
  ;

  let TokenWalker_Create (
    _s: Token[],
    index: int,
    ctx: unknown,
    types: TokenType[],
    errors: CompilerError[]
  ): TokenWalker =
      let all = _s;
    _s @ index |
      let (_s: Token) =
        {
          tokens = all,
          index = index,
          current = _s,
          ctx = ctx,
          text = _s.data,
          types = types,
          range = _s.range,
          location = _s.range.from,
          errors = errors,
          done = false,
        }
      ;
      let (_s: unknown) =
        {
          tokens = all,
          index = index,
          current = { data = "", range = Range_Empty },
          ctx = ctx,
          text = "",
          types = types,
          range = Range_Empty,
          location = Range_Empty.from,
          errors = errors,
          done = false,
        }
      ;
  ;

  let TokenWalker_Start (_s: Token[]): TokenWalker =
    _s --> ({
      index = 0,
      ctx = dictionary_create,
      types = [] as TokenType[],
      errors = [] as CompilerError[],
    } -> TokenWalker_Create)
  ;

  let TokenWalker_Previous (_s: TokenWalker): TokenWalker =
    {
      _s = _s.tokens,
      index = _s.index - 1,
      ctx = _s.ctx,
      types = _s.types,
      errors = _s.errors,
    } -> TokenWalker_Create
  ;

  let TokenWalker_Expect (
    _s: TokenWalker,
    expected: string[],
    typeName: string
  ): TokenWalker =
      let walker = _s;
    {
      _s = expected,
      predicate = let (_s: string) =
        walker.text == _s
      ;
    } -> iterator_some
      ? {
        _s = _s.tokens,
        ctx = _s.ctx,
        types = _s.types,
        index = _s.index + 1,
        errors = _s.errors ++ {
          range = _s.range,
          message =
            "Expected " +
            ({ _s = expected, separator = ", " } -> std_string_join) +
            " but found " +
            _s.text,
        },
      } -> TokenWalker_Create
      : {
        _s = _s.tokens,
        index = _s.index + 1,
        ctx = _s.ctx,
        types = _s.types,
        errors = _s.errors,
      } -> TokenWalker_Create
  ;

  let TokenWalker_Text (
    _s: TokenWalker,
    property: string,
    typeName: string
  ): TokenWalker =
    {
      _s = _s.tokens,
      index = _s.index + 1,
      ctx = { _s = _s.ctx, key = property, value = _s.text } -> dictionary_set,
      types = _s.types,
      errors = _s.errors,
    } -> TokenWalker_Create
  ;

  let TokenWalker_Finish (_s: TokenWalker) =
    {
      walker =
        {
          _s = _s.tokens,
          index = _s.index,
          ctx = dictionary_create,
          types = _s.types,
          errors = _s.errors,
        } -> TokenWalker_Create,
      ctx = _s.ctx,
    }
  ;

  struct ExtractResult
    done: TokenWalker
  ;

  let TokenWalker_Extract (
    walker: TokenWalker,
    name: string,
    extractor: (_s: TokenWalker, so_far: Dictionary): ExtractResult
  ) =
      let result = { _s = walker, so_far = walker.ctx } -> extractor;
    {
      ...result.done,
      ctx = { _s = walker.ctx, key = name, value = result } -> dictionary_set
    }
  ;

  let TokenWalker_If (
    walker: TokenWalker,
    predicate: (_s: TokenWalker): bool,
    extractor: (_s: TokenWalker): TokenWalker
  ) = 
    walker --> predicate
      ? walker --> extractor
      : walker
  ;

  let TokenWalker_While (
    _s: TokenWalker,
    name: string,
    extractor: (_s: TokenWalker, so_far: Dictionary): ExtractResult
  ) =
      let result = { _s = _s, so_far = _s.ctx } -> extractor;
    {
      ...result.done,
      ctx = { _s = _s.ctx, key = name, value = result } -> dictionary_set
    }
  ;
}
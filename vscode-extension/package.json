{
  "name": "cinderblock-language",
  "displayName": "Cinderblock Language",
  "description": "Cinderblock languages features for VS Code",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:cinderblock"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cinderblock",
        "extensions": [
          ".cb"
        ]
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "templateType",
        "superType": "type",
        "description": "A template type."
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "native",
        "description": "Annotates a symbol that is implemented natively"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "bundle": "vsce package",
    "lint": "exit 0"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/node": "24.x",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "@vscode/vsce": "^3.9.2",
    "@cinderblock/compiler": "*"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PaulPopat/cinderblock.git",
    "directory": "vscode-extension"
  }
}
